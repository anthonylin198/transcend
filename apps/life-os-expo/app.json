{
  "expo": {
    "name": "lifeOS",
    "slug": "lifeOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifeosexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anthonylin198.lifeosexpo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anthonylin198.lifeosexpo",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow lifeOS to access your calendar so we can show today's upcoming events."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Allow lifeOS to read your step count so your group week and an expanded day can show how much you've moved.",
          "NSHealthUpdateUsageDescription": "lifeOS reads your step count and does not write health data.",
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anthonylin198.lifeosexpo.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.anthonylin198.lifeosexpo",
          "widgets": [
            {
              "name": "CalorieWidget",
              "displayName": "Calories",
              "description": "Today's calories and protein",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            },
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Today's priorities and habits",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c016465f-2a79-408a-90ad-2458c0fa7c42"
      }
    }
  }
}
